
# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================

.env
.env.*
!.env.example
!.env.template

# Firebase service account credentials
serviceAccountKey.json
*serviceAccount*.json
firebase-adminsdk-*.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ==========================================
# NODE.JS DEPENDENCIES
# ==========================================

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Package manager cache
.npm/
.yarn/
.pnpm-store/

# ==========================================
# BUILD OUTPUTS
# ==========================================

dist/
build/
out/
.next/
.nuxt/
.output/

# Vite cache
.vite/
**/.vite/

# Coverage reports
coverage/
.nyc_output/

# ==========================================
# LOGS AND TEMPORARY FILES
# ==========================================

logs/
*.log
*.tmp
*.temp
temp/
tmp/

# ==========================================
# UPLOADS AND GENERATED FILES
# ==========================================

uploads/*
!uploads/.gitkeep

generated/*
!generated/.gitkeep

# ==========================================
# DOCKER
# ==========================================

.dockerignore

# ==========================================
# IDE AND EDITORS
# ==========================================

.vscode/
.idea/
*.suo
*.user
*.sln.docstates

# ==========================================
# OPERATING SYSTEM FILES
# ==========================================

.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# TESTING AND DEBUGGING
# ==========================================

.npmrc.local
.eslintcache
.stylelintcache

# ==========================================
# MISCELLANEOUS
# ==========================================

*.bak
*.old
*.swp
*.swo
*.orig
*.patch
